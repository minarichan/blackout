# Copy to .env at the repo root or backend/.env.
# Public RPCs work for a demo. For a deployment, set your own endpoints.

APP_NAME=Blackout
LOG_LEVEL=INFO

# sqlite is the default and needs no extra service
# DATABASE_URL=sqlite:///./data/blackout.db

CORS_ORIGINS=http://localhost:5173,http://localhost:8080
CACHE_TTL_SECONDS=45
METADATA_TTL_SECONDS=600
REQUEST_TIMEOUT_SECONDS=20
RATE_LIMIT_PER_MINUTE=30
MIN_POSITION_USD=1

ENABLED_CHAINS=ethereum,arbitrum,base,optimism

# Optional. Comma-separated fallbacks are allowed.
# ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
# ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
# BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
# OPTIMISM_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR_KEY

# Optional CoinGecko demo key. Pricing still works without it.
# COINGECKO_API_KEY=
